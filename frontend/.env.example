# Base URL for the backend API. In local dev this is left as "/api/v1" and
# proxied to the backend (see vite.config.ts server.proxy) to avoid CORS.
# For a production build pointing at a separately hosted backend, set the
# full URL, e.g. https://api.inventarsystem.example.com/api/v1
VITE_API_URL=/api/v1
