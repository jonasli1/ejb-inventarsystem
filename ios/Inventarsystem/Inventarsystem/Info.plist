<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Zum Scannen von Inventarstickern per Kamera.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Zum Auswählen eines Fotos eines Inventarstickers.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Self-hosted instances are explicitly documented as reachable over plain HTTP on a
		     local network (e.g. http://192.168.1.50:8080), not just HTTPS. This exception covers
		     only loopback/private-network addresses and .local hostnames; any public internet
		     domain still requires full ATS-compliant HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
