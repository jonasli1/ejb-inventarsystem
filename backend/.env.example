# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://inventarsystem:inventarsystem@localhost:5432/inventarsystem?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Rate limiting ---
THROTTLE_TTL=60000
# Applies to every endpoint except the auth ones below. A single page load
# fires the list itself, several reference-data lookups, and one thumbnail
# request per visible row - 300/min covers normal interactive use (even
# several people on the same connection) while still blocking a scripted
# flood.
THROTTLE_LIMIT=300
# Stricter limit applied specifically to /auth/login, /auth/forgot-password
# (keyed by IP+email, see AuthThrottlerGuard), /auth/refresh and
# /auth/passkey/login/verify (keyed by IP, global guard).
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL=60000

# Number of reverse-proxy hops in front of this process, used for
# `app.set('trust proxy', ...)`. This deployment always runs behind
# Caddy -> nginx (frontend container) -> backend, i.e. 2 hops. Getting this
# wrong makes every client look like it has the SAME IP (the innermost
# proxy's), which silently breaks IP-based rate limiting for everyone.
TRUST_PROXY_HOPS=2

# --- ChurchTools OAuth2 ---
CHURCHTOOLS_BASE_URL=https://example.church.tools
CHURCHTOOLS_CLIENT_ID=change-me
CHURCHTOOLS_CLIENT_SECRET=change-me
# Points at the frontend's callback route, which relays code+state to the
# backend's GET /auth/churchtools/callback endpoint (see frontend/src/features/auth).
CHURCHTOOLS_REDIRECT_URI=http://localhost:5173/auth/churchtools/callback
CHURCHTOOLS_AUTHORIZATION_URL=https://example.church.tools/oauth/authorize
CHURCHTOOLS_TOKEN_URL=https://example.church.tools/oauth/token
CHURCHTOOLS_PROFILE_URL=https://example.church.tools/api/whoami
CHURCHTOOLS_SCOPE=openid profile groups

# --- WebAuthn / Passkey ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Inventarsystem
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Seed / initial admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=System Administrator

# --- File uploads ---
# Directory (relative to the backend process cwd, or absolute) where article/
# inventory/loan attachments are stored. In Docker this should be a mounted volume.
UPLOADS_DIR=./uploads

# --- Backups ---
# 32+ char secret used to AES-256-GCM encrypt stored SFTP/OneDrive credentials.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_SECRET_KEY=change-me-32-char-minimum-secret-key

# --- Microsoft Graph OAuth2 (OneDrive backup destination, optional) ---
# Requires an Azure AD app registration (delegated Files.ReadWrite permission).
# Not needed if you only use the SFTP backup destination.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:5173/settings/backup/onedrive/callback
