# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://inventarsystem:inventarsystem@localhost:5432/inventarsystem?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=20

# --- ChurchTools OAuth2 ---
CHURCHTOOLS_BASE_URL=https://example.church.tools
CHURCHTOOLS_CLIENT_ID=change-me
CHURCHTOOLS_CLIENT_SECRET=change-me
CHURCHTOOLS_REDIRECT_URI=http://localhost:3000/api/v1/auth/churchtools/callback
CHURCHTOOLS_AUTHORIZATION_URL=https://example.church.tools/oauth/authorize
CHURCHTOOLS_TOKEN_URL=https://example.church.tools/oauth/token
CHURCHTOOLS_PROFILE_URL=https://example.church.tools/api/whoami
CHURCHTOOLS_SCOPE=openid profile groups

# --- WebAuthn / Passkey ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Inventarsystem
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Seed / initial admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=System Administrator
