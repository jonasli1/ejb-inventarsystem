# --- App ---
NODE_ENV=test
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=*

# --- Database (separate test database) ---
DATABASE_URL="postgresql://inventarsystem:inventarsystem@localhost:5432/inventarsystem_test?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=test-access-secret-please-change
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-please-change
JWT_REFRESH_EXPIRES_IN=30d

# --- Rate limiting (generous for tests) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
THROTTLE_AUTH_LIMIT=1000
THROTTLE_AUTH_TTL=60000

# --- ChurchTools OAuth2 (unused in tests, mocked) ---
CHURCHTOOLS_BASE_URL=https://example.church.tools
CHURCHTOOLS_CLIENT_ID=test-client
CHURCHTOOLS_CLIENT_SECRET=test-secret
CHURCHTOOLS_REDIRECT_URI=http://localhost:3001/api/v1/auth/churchtools/callback
CHURCHTOOLS_AUTHORIZATION_URL=https://example.church.tools/oauth/authorize
CHURCHTOOLS_TOKEN_URL=https://example.church.tools/oauth/token
CHURCHTOOLS_PROFILE_URL=https://example.church.tools/api/whoami
CHURCHTOOLS_SCOPE=openid profile groups

# --- WebAuthn / Passkey ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Inventarsystem Test
WEBAUTHN_ORIGIN=http://localhost:3001

# --- Seed / initial admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=System Administrator

# --- File uploads (separate dir so e2e runs don't pollute dev uploads) ---
UPLOADS_DIR=./uploads-test

# --- Backups ---
BACKUP_SECRET_KEY=0610e0038e9bdb91020016b23517446d1f612da2b9fbfdce2f1341edc552b211

# --- Microsoft Graph OAuth2 (unused in tests) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3001/settings/backup/onedrive/callback
